# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# NONE of this is required to run the demo: `python -m salvage demo` works offline with
# recorded Razorpay fixtures and recorded model verdicts, on a clone with no credentials.

# Razorpay TEST mode only (keys start rzp_test_). Free and instant on signup, no KYC.
# Needed only for `salvage run --record`, which refreshes fixtures from real test traffic.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Any OpenAI-compatible endpoint. Mistral by default -- its free tier needs no card.
# Gemini, Groq, Cerebras and OpenRouter all speak the same protocol: change the two
# variables below and nothing else. Needed only to record NEW model verdicts; the ones
# this repo ships with replay from fixtures/llm_verdicts.json at zero cost.
SALVAGE_LLM_API_KEY=
SALVAGE_LLM_BASE_URL=https://api.mistral.ai/v1
SALVAGE_LLM_MODEL=mistral-small-latest
